{
  "name": "@dezin/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dezin daemon — local Project, Design Canvas, Agent, capture, and Moodboard services.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types --experimental-sqlite --no-warnings src/start.ts",
    "test": "node --experimental-strip-types --experimental-sqlite --no-warnings --import ./test/no-proxy.ts --test --test-concurrency=4 'test/*.test.ts'",
    "test:coverage": "node --experimental-strip-types --experimental-sqlite --no-warnings --import ./test/no-proxy.ts --experimental-test-coverage --test-coverage-include='src/**/*' --test-coverage-exclude='**/*.test.*' --test-coverage-lines=82 --test-coverage-branches=75 --test-coverage-functions=78 --test --test-concurrency=4 'test/*.test.ts'"
  },
  "dependencies": {
    "@ai-sdk/azure": "^4.0.56",
    "@ai-sdk/fal": "^3.0.35",
    "@ai-sdk/google": "^4.0.59",
    "@ai-sdk/google-vertex": "^5.0.71",
    "@ai-sdk/openai-compatible": "^3.0.41",
    "@babel/parser": "^7.29.7",
    "@dezin/agent": "workspace:*",
    "@dezin/core": "workspace:*",
    "@dezin/design": "workspace:*",
    "@dezin/design-canvas-contracts": "workspace:*",
    "@dezin/effects": "workspace:*",
    "@napi-rs/canvas": "1.0.2",
    "ai": "^7.0.87",
    "fflate": "^0.8.3",
    "kiwi-schema": "^0.5.0",
    "lightningcss": "^1.32.0",
    "parse5": "^7.3.0",
    "pdfjs-dist": "6.2.108",
    "puppeteer-core": "^25.9.0",
    "typescript": "^6.0.3",
    "undici": "^7.29.0",
    "vite": "^8.0.16"
  }
}
